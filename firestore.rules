rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // A brand-new user profile must start at zero balance / unverified status.
    // The server (Admin SDK) is the only thing that can ever change balance or status.
    function isValidNewUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'status', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.balance == 0 &&
             data.status == 'unverified' &&
             data.createdAt is number;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewUserProfile(incoming());

      // Users may update their own display info only. balance, status, uid and
      // email can never be touched by a client write, on create or update.
      allow update: if isOwner(userId) &&
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().balance == existing().balance &&
                    incoming().status == existing().status &&
                    incoming().diff(existing()).affectedKeys()
                      .hasOnly(['displayName', 'currency', 'photoURL', 'phoneNumber']);

      // Wallet balances are entirely server-managed (deposits/withdrawals/trades
      // are only ever applied by the Admin SDK backend, which bypasses these rules).
      match /wallets/{walletId} {
        allow list, get: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Transactions: a client may only FILE a pending request. Filing a
      // transaction never moves money by itself — only the server can mark
      // one completed/failed and update the balance, atomically, in the same
      // write. A user may cancel their own still-pending request and nothing else.
      match /transactions/{transactionId} {
        function isValidTransactionRequest(data) {
          return data.keys().hasAll(['userId', 'type', 'amount', 'coin', 'status', 'timestamp']) &&
                 data.userId == request.auth.uid &&
                 data.type in ['deposit', 'withdrawal', 'transfer'] &&
                 data.amount is number && data.amount > 0 &&
                 data.status == 'pending';
