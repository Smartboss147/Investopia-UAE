rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email in [
          'smartboss08161156487@gmail.com',
          'smartcompany112234@gmail.com',
          'prince.hamad.managementhmdzs@gmail.com'
        ]) ||
        ('email' in request.auth.token && request.auth.token.email.lower() in [
          'smartboss08161156487@gmail.com',
          'smartcompany112234@gmail.com',
          'prince.hamad.managementhmdzs@gmail.com'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    // Tesla Product Validation
    function isValidTeslaProduct(data) {
      return data.keys().hasAll(['name', 'slug', 'category', 'price', 'currency', 'availability']) &&
             data.name is string && data.name.size() <= 200 &&
             data.slug is string &&
             data.category in ['Vehicles', 'Charging', 'Accessories', 'Technology', 'Lifestyle'] &&
             data.price is number &&
             data.currency in ['AED', 'USD', 'EUR', 'GBP', 'NGN'] &&
             data.availability in ['Available', 'Out of Stock', 'Coming Soon'];
    }

    // Tesla Order Validation
    function isValidTeslaOrder(data) {
      return data.keys().hasAll(['userId', 'status', 'currency', 'totalAmount', 'items', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.status in ['pending', 'confirmed'] &&
             data.currency is string &&
             data.totalAmount is number &&
             data.items is list &&
             data.createdAt is string;
    }

    match /tesla_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tesla_orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidTeslaOrder(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'status', 'currency', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.balance is number &&
             data.status in ['unverified', 'active', 'suspended'] &&
             (!('displayName' in data) || data.displayName == null || data.displayName is string);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && isValidUserProfile(incoming()));
      allow update: if isAdmin() || (isOwner(userId) && 
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().balance == existing().balance &&
                    incoming().status == existing().status &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currency']));
      allow delete: if isAdmin();
      
      // Wallets subcollection
      match /wallets/{walletId} {
        function isValidWallet(data) {
          return data.keys().hasAll(['userId', 'coin', 'symbol', 'balance', 'address']) &&
                 data.userId == request.auth.uid &&
                 data.coin is string &&
                 data.symbol is string && data.symbol.size() <= 10 &&
                 data.balance is number &&
                 data.address is string && data.address.matches('^[a-zA-Z0-9]+$');
        }

        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || (isOwner(userId) && isValidWallet(incoming()) && incoming().balance == 0);
        allow update: if isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        function isValidTransaction(data) {
          return data.keys().hasAll(['userId', 'type', 'amount', 'coin', 'status', 'timestamp']) &&
                 data.userId == request.auth.uid &&
                 data.type in ['deposit', 'withdrawal', 'transfer', 'trade', 'reward', 'adjustment'] &&
                 data.amount is number &&
                 data.status in ['pending', 'completed', 'cancelled', 'failed'] &&
                 data.timestamp is number;
        }

        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || (isOwner(userId) && isValidTransaction(incoming()));
        allow update: if isAdmin() || (isOwner(userId) && 
                      existing().status == 'pending' &&
                      incoming().status == 'cancelled' &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']));
        allow delete: if isAdmin();
      }

      // Price Alerts subcollection
      match /price_alerts/{alertId} {
        function isValidAlert(data) {
          return data.keys().hasAll(['userId', 'symbol', 'targetPrice', 'condition', 'isActive', 'createdAt']) &&
                 data.userId == request.auth.uid &&
                 data.symbol is string &&
                 data.targetPrice is number &&
                 data.condition in ['above', 'below'] &&
                 data.isActive is bool &&
                 data.createdAt is number;
        }

        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidAlert(incoming());
        allow update: if isOwner(userId) && isValidAlert(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
