rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'status']) &&
             data.keys().size() <= 7 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.balance is number &&
             data.status in ['active', 'suspended', 'unverified'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'balance', 'status', 'currency']);
      
      // Wallets subcollection
      match /wallets/{walletId} {
        function isValidWallet(data) {
          return data.keys().hasAll(['userId', 'coin', 'symbol', 'balance', 'address']) &&
                 data.userId == request.auth.uid &&
                 data.coin is string &&
                 data.symbol is string && data.symbol.size() <= 10 &&
                 data.balance is number &&
                 data.address is string && data.address.matches('^[a-zA-Z0-9]+$');
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWallet(incoming());
        allow update: if isOwner(userId) && isValidWallet(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['balance']);
        allow delete: if isOwner(userId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        function isValidTransaction(data) {
          return data.keys().hasAll(['userId', 'type', 'amount', 'coin', 'status', 'timestamp']) &&
                 data.userId == request.auth.uid &&
                 data.type in ['deposit', 'withdrawal', 'transfer', 'trade', 'reward'] &&
                 data.amount is number &&
                 data.status in ['pending', 'completed', 'failed', 'cancelled'];
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming());
        // Transactions are generally immutable once completed
        allow update: if isOwner(userId) && isValidTransaction(incoming()) &&
                      existing().status == 'pending' &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'txHash']);
      }
    }
  }
}
