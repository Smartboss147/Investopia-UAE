rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Tesla Product Validation
    function isValidTeslaProduct(data) {
      return data.keys().hasAll(['name', 'slug', 'category', 'price', 'currency', 'availability']) &&
             data.name is string && data.name.size() <= 200 &&
             data.slug is string &&
             data.category in ['Vehicles', 'Charging', 'Accessories', 'Technology', 'Lifestyle'] &&
             data.price is number &&
             data.currency in ['AED', 'USD', 'EUR', 'GBP', 'NGN'] &&
             data.availability in ['Available', 'Out of Stock', 'Coming Soon'];
    }

    // Tesla Order Validation
    function isValidTeslaOrder(data) {
      return data.keys().hasAll(['userId', 'status', 'currency', 'totalAmount', 'items', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.status in ['pending', 'confirmed'] &&
             data.currency is string &&
             data.totalAmount is number &&
             data.items is list &&
             data.createdAt is string;
    }

    match /tesla_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tesla_orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTeslaOrder(incoming());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'status', 'currency', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.balance == 0 &&
             data.status == 'unverified' &&
             data.createdAt is number &&
             (!('displayName' in data) || data.displayName == null || data.displayName is string);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isAdmin() || (isOwner(userId) && 
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().balance == existing().balance &&
                    incoming().status == existing().status &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currency']));
      
      // Wallets subcollection - Server-only balance updates
      match /wallets/{walletId} {
        function isValidWallet(data) {
          return data.keys().hasAll(['userId', 'coin', 'symbol', 'balance', 'address']) &&
                 data.userId == request.auth.uid &&
                 data.coin is string &&
                 data.symbol is string && data.symbol.size() <= 10 &&
                 data.balance is number &&
                 data.address is string && data.address.matches('^[a-zA-Z0-9]+$');
        }

        allow list, get: if isOwner(userId) || isAdmin();
        // Clients can create wallets with 0 balance, but balance updates must be server-side
        allow create: if isOwner(userId) && isValidWallet(incoming()) && incoming().balance == 0;
        allow update: if isAdmin(); // Lock down balance updates to Admin SDK
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        function isValidTransaction(data) {
          return data.keys().hasAll(['userId', 'type', 'amount', 'coin', 'status', 'timestamp']) &&
                 data.userId == request.auth.uid &&
                 data.type in ['deposit', 'withdrawal', 'transfer', 'trade', 'reward'] &&
                 data.amount is number &&
                 data.status == 'pending' &&
                 data.timestamp is number;
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming());
        
        // Clients can only cancel pending transactions
        allow update: if isOwner(userId) && 
                      existing().status == 'pending' &&
                      incoming().status == 'cancelled' &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }

      // Price Alerts subcollection
      match /price_alerts/{alertId} {
        function isValidAlert(data) {
          return data.keys().hasAll(['userId', 'symbol', 'targetPrice', 'condition', 'isActive', 'createdAt']) &&
                 data.userId == request.auth.uid &&
                 data.symbol is string &&
                 data.targetPrice is number &&
                 data.condition in ['above', 'below'] &&
                 data.isActive is bool &&
                 data.createdAt is number;
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAlert(incoming());
        allow update: if isOwner(userId) && isValidAlert(incoming());
        allow delete: if isOwner(userId);
      }
    }
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}

